# ##############################################################################
# Компиляция и Бинарники
# ##############################################################################
# Главный исполняемый файл приложения (может называться app, main или по имени репозитория)
/app
/main
/go-shop-backend

# Исполняемые файлы под разные ОС
*.exe
*.exe~
*.dll
*.so
*.dylib

# Временные файлы тестов
*.test
*.prof

# ##############################################################################
# Логирование и Конфигурация
# ##############################################################################
# Файлы локальных переменных окружения (содержат JWT_SECRET и приватные доступы)
.env
.env.local
.env.*.local

# Файлы логов, генерируемые вашим компонентом logger
*.log
app_*.log

# ##############################################################################
# База данных (SQLite)
# ##############################################################################
# Локальные файлы базы данных (включая дефолтный shop.db и временные файлы из тестов)
*.db
shop.db

# Служебные файлы транзакций SQLite (Rollback Journal и Write-Ahead Log)
*.db-journal
*.db-shm
*.db-wal

# ##############################################################################
# Инструменты тестирования (Тестовое покрытие)
# ##############################################################################
# Файлы отчетов покрытия кода тестами (go tool cover)
coverage.out
coverage.html
coverage.txt

# ##############################################################################
# Настройки IDE и редакторов кода
# ##############################################################################
# JetBrains (GoLand, IntelliJ IDEA)
.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code
.vscode/
!.vscode/extensions.json

# Временные файлы vim / nano
*~
*.swp

# ##############################################################################
# Системные файлы операционных систем
# ##############################################################################
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Ehthumbs.db
Desktop.ini